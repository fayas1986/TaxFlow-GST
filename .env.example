# WhatsApp Notification Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# QuickBooks Integration
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_ENVIRONMENT=Sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/v1/quickbooks/callback

# Xero Integration
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=http://localhost:3000/api/v1/xero/callback

# PostgreSQL Multi-Tenant Database
DATABASE_URL=postgres://user:password@localhost:5432/taxflow?sslmode=disable
