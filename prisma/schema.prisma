// ==========================================
// Generator & Datasource Configurations
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum PartyType {
  CUSTOMER
  VENDOR
  BOTH
}

enum HsnType {
  GOODS
  SERVICES
}

enum InvoiceCategory {
  SALES
  PURCHASE
}

enum InvoiceType {
  B2B
  B2C
  SEZ_WITH_PAYMENT
  SEZ_WITHOUT_PAYMENT
  EXPORT_WITH_PAYMENT
  EXPORT_WITHOUT_PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  VALIDATED
  POSTED
  CANCELLED
}

enum TaxPeriodStatus {
  OPEN
  PROCESSING_REVIEW
  APPROVED
  FILED
  LOCKED
}

enum LedgerEntryType {
  OUTPUT_LIABILITY
  INPUT_TAX_CREDIT
  LIABILITY_REVERSAL
  ITC_REVERSAL
  ADJUSTMENT
}

enum ItcStatus {
  IDENTIFIED
  ELIGIBLE
  INELIGIBLE
  PARTIALLY_ELIGIBLE
  CLAIMED
  REVERSED
  RECLAIMED
  UTILIZED
}

enum Gstr2bItcAvailability {
  ELIGIBLE
  INELIGIBLE
  BLOCKED
}

enum ReconciliationMatchStatus {
  EXACT_MATCH
  AMOUNT_MISMATCH
  TAX_HEAD_MISMATCH
  DATE_MISMATCH
  MISSING_IN_GSTR2B
  MISSING_IN_BOOKS
  SECTION_17_5_BLOCKED
}

enum ReturnType {
  GSTR1
  GSTR3B
  GSTR9
}

enum ReturnStatus {
  DRAFT
  VALIDATED
  REVIEW
  APPROVED
  SUBMITTED
  FILED
  REJECTED
}

enum FilingStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  RETRYING
}

enum EInvoiceStatus {
  NOT_GENERATED
  VALIDATING
  SUBMITTING
  GENERATED
  CANCEL_PENDING
  CANCELLED
  FAILED
}

enum EWayBillStatus {
  NOT_GENERATED
  GENERATED
  UPDATED_VEHICLE
  CANCELLED
  EXPIRED
  FAILED
}

enum GspEnvironment {
  SANDBOX
  PRODUCTION
}

enum AuditCategory {
  AUTHENTICATION
  INVOICE_MUTATION
  MASTER_DATA_MUTATION
  TAX_PERIOD_LOCK
  LEDGER_POSTING
  ITC_MUTATION
  GSTR2B_IMPORT
  RECONCILIATION_RUN
  SECURITY_VIOLATION
  GST_RETURN_MUTATION
  GST_RETURN_APPROVAL
  GST_RETURN_FILING
  E_INVOICE_MUTATION
  E_WAY_BILL_MUTATION
  GOV_CREDENTIAL_MUTATION
  GOV_API_CALL
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ApprovalEntityType {
  SALES_INVOICE
  PURCHASE_INVOICE
  GST_RETURN
  ITC_REVERSAL
  TAX_LEDGER_REVERSAL
  E_INVOICE_CANCEL
}

enum DocumentType {
  INVOICE_ATTACHMENT
  PURCHASE_BILL
  GSTR2B_FILE
  RETURN_ACKNOWLEDGEMENT
  E_WAY_BILL_PDF
  COMPLIANCE_EXPORT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
  DEAD_LETTER
}

enum IntegrationProvider {
  GENERIC_REST
  CSV_EXCEL
  DYNAMICS_365
  SAP
  TALLY
  ORACLE
  CUSTOM
}

enum SyncRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_SUCCESS
  FAILED
}

enum IntegrationErrorCategory {
  VALIDATION_ERROR
  MAPPING_ERROR
  AUTHENTICATION_ERROR
  CONNECTIVITY_ERROR
  RATE_LIMIT
  DUPLICATE
  DOMAIN_ERROR
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum BackgroundJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  STALLED
  DEAD_LETTER
}

enum JobDomain {
  ERP_SYNC
  GSTR_FILING
  GSTR_IMPORT
  RECONCILIATION
  GOVERNMENT_API
  NOTIFICATION
  BILLING_USAGE
  DOCUMENT_PROCESSING
  AI_AUTOMATION
  STATUTORY_COMPLIANCE
}

// ==========================================
// Core Multi-Tenant & Organizational Models
// ==========================================

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  code      String       @unique @db.VarChar(50)
  planCode  String       @default("ENTERPRISE") @map("plan_code") @db.VarChar(50)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  companies          Company[]
  users              User[]
  gstRegistrations   GSTRegistration[]
  branches           Branch[]
  parties            Party[]
  partyGstins        PartyGSTIN[]
  salesInvoices      SalesInvoice[]
  taxPeriods         TaxPeriod[]
  taxLedgerEntries   TaxLedgerEntry[]
  gstr2bImportBatches Gstr2bImportBatch[]
  gstr2bRecords      Gstr2bRecord[]
  itcRecords         ItcRecord[]
  reconciliationRuns ReconciliationRun[]
  reconciliationMatches ReconciliationMatch[]
  auditLogs          AuditLog[]
  gstReturns         GstReturn[]
  gstReturnVersions  GstReturnVersion[]
  filingSubmissions  FilingSubmissionLog[]
  eInvoices          EInvoiceRecord[]
  eWayBills          EWayBillRecord[]
  govCredentials     GovGspCredential[]
  govApiLogs         GovApiAuditLog[]
  approvalWorkflows   ApprovalWorkflow[]
  approvalRequests    ApprovalRequest[]
  approvalDelegations ApprovalDelegation[]
  immutableAuditLogs  ImmutableAuditLog[]
  documents           DocumentMetadata[]
  notifications       NotificationRecord[]
  erpIntegrations          ErpIntegration[]
  integrationMappingConfigs IntegrationMappingConfig[]
  syncRunLogs              SyncRunLog[]
  importedTransactions     ImportedTransactionRecord[]
  integrationErrors        IntegrationErrorLog[]
  subscriptions            Subscription[]
  usageCounters            UsageCounterRecord[]
  usageEvents              UsageEventLog[]
  billingEvents            BillingEvent[]
  backgroundJobs           BackgroundJobRecord[]

  @@map("tenants")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(255)
  legalName String   @map("legal_name") @db.VarChar(255)
  pan       String   @db.VarChar(10)
  email     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gstRegistrations GSTRegistration[]
  branches         Branch[]
  salesInvoices    SalesInvoice[]
  taxLedgerEntries TaxLedgerEntry[]
  itcRecords       ItcRecord[]
  userScopes       UserScope[]
  gstReturns       GstReturn[]
  eInvoices        EInvoiceRecord[]
  eWayBills        EWayBillRecord[]

  @@unique([id, tenantId])
  @@unique([tenantId, pan])
  @@index([tenantId])
  @@map("companies")
}

model GSTRegistration {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  gstin            String   @db.VarChar(15)
  legalName        String   @map("legal_name") @db.VarChar(255)
  tradeName        String?  @map("trade_name") @db.VarChar(255)
  stateCode        String   @map("state_code") @db.VarChar(2)
  registrationType String   @default("REGULAR") @map("registration_type") @db.VarChar(50)
  status           String   @default("ACTIVE") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company             Company             @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  branches            Branch[]
  salesInvoices       SalesInvoice[]
  taxPeriods          TaxPeriod[]
  taxLedgerEntries    TaxLedgerEntry[]
  gstr2bImportBatches Gstr2bImportBatch[]
  gstr2bRecords       Gstr2bRecord[]
  itcRecords          ItcRecord[]
  reconciliationRuns  ReconciliationRun[]
  userScopes          UserScope[]
  gstReturns          GstReturn[]
  eInvoices           EInvoiceRecord[]
  eWayBills           EWayBillRecord[]
  govCredentials      GovGspCredential[]
  govApiLogs          GovApiAuditLog[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, companyId])
  @@unique([tenantId, gstin])
  @@index([companyId])
  @@map("gst_registrations")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  gstinId      String   @map("gstin_id") @db.Uuid
  branchCode   String   @map("branch_code") @db.VarChar(50)
  name         String   @db.VarChar(255)
  stateCode    String   @map("state_code") @db.VarChar(2)
  isHeadOffice Boolean  @default(false) @map("is_head_office")
  address      Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company          @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  gstRegistration  GSTRegistration  @relation(fields: [gstinId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)
  salesInvoices    SalesInvoice[]
  taxLedgerEntries TaxLedgerEntry[]
  itcRecords       ItcRecord[]
  userScopes       UserScope[]

  @@unique([id, tenantId])
  @@unique([tenantId, companyId, branchCode])
  @@index([gstinId])
  @@map("branches")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  role         String   @default("TAX_ANALYST") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scopes UserScope[]

  @@unique([tenantId, email])
  @@map("users")
}

model UserScope {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  gstinId   String?  @map("gstin_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gstRegistration GSTRegistration? @relation(fields: [gstinId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_scopes")
}

// ==========================================
// Master Data Models
// ==========================================

model Party {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  partyCode String    @map("party_code") @db.VarChar(50)
  legalName String    @map("legal_name") @db.VarChar(255)
  tradeName String?   @map("trade_name") @db.VarChar(255)
  partyType PartyType @map("party_type")
  pan       String?   @db.VarChar(10)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(20)
  address   Json?     @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partyGstins   PartyGSTIN[]
  salesInvoices SalesInvoice[]

  @@unique([id, tenantId])
  @@unique([tenantId, partyCode])
  @@map("parties")
}

model PartyGSTIN {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  partyId   String   @map("party_id") @db.Uuid
  gstin     String   @db.VarChar(15)
  stateCode String   @map("state_code") @db.VarChar(2)
  address   Json?    @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party  Party  @relation(fields: [partyId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, partyId, gstin])
  @@index([partyId])
  @@map("party_gstins")
}

model HsnSacMaster {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique @db.VarChar(10)
  description   String    @db.Text
  type          HsnType   @default(GOODS)
  igstRate      Decimal   @default(18.00) @map("igst_rate") @db.Decimal(5, 2)
  cgstRate      Decimal   @default(9.00) @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate      Decimal   @default(9.00) @map("sgst_rate") @db.Decimal(5, 2)
  cessRate      Decimal   @default(0.00) @map("cess_rate") @db.Decimal(5, 2)
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([code])
  @@map("hsn_sac_masters")
}

model TaxRateRule {
  id            String    @id @default(uuid()) @db.Uuid
  ruleCode      String    @unique @map("rule_code") @db.VarChar(50)
  description   String    @db.Text
  version       String    @default("1.0.0") @db.VarChar(20)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("tax_rate_rules")
}

// ==========================================
// Transaction & Invoicing Models
// ==========================================

model TaxPeriod {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  gstinId   String          @map("gstin_id") @db.Uuid
  periodKey String          @map("period_key") @db.VarChar(7) // MMYYYY
  status    TaxPeriodStatus @default(OPEN)
  isLocked  Boolean         @default(false) @map("is_locked")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gstRegistration     GSTRegistration     @relation(fields: [gstinId, tenantId], references: [id, tenantId], onDelete: Cascade)
  salesInvoices       SalesInvoice[]
  taxLedgerEntries    TaxLedgerEntry[]
  itcRecords          ItcRecord[]
  gstr2bImportBatches Gstr2bImportBatch[]
  gstr2bRecords       Gstr2bRecord[]
  reconciliationRuns  ReconciliationRun[]
  gstReturns          GstReturn[]

  @@unique([id, tenantId])
  @@unique([tenantId, gstinId, periodKey])
  @@map("tax_periods")
}

model SalesInvoice {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  companyId              String          @map("company_id") @db.Uuid
  gstinId                String          @map("gstin_id") @db.Uuid
  branchId               String?         @map("branch_id") @db.Uuid
  partyId                String          @map("party_id") @db.Uuid
  taxPeriodId            String          @map("tax_period_id") @db.Uuid
  category               InvoiceCategory @default(SALES)
  invoiceType            InvoiceType     @default(B2B) @map("invoice_type")
  status                 InvoiceStatus   @default(DRAFT)
  invoiceNumber          String          @map("invoice_number") @db.VarChar(100)
  invoiceDate            DateTime        @map("invoice_date") @db.Date
  placeOfSupplyStateCode String          @default("27") @map("place_of_supply_state_code") @db.VarChar(2)
  isReverseCharge        Boolean         @default(false) @map("is_reverse_charge")
  totalTaxableAmount     Decimal         @default(0.0000) @map("total_taxable_amount") @db.Decimal(16, 4)
  totalCgstAmount        Decimal         @default(0.0000) @map("total_cgst_amount") @db.Decimal(16, 4)
  totalSgstAmount        Decimal         @default(0.0000) @map("total_sgst_amount") @db.Decimal(16, 4)
  totalIgstAmount        Decimal         @default(0.0000) @map("total_igst_amount") @db.Decimal(16, 4)
  totalCessAmount        Decimal         @default(0.0000) @map("total_cess_amount") @db.Decimal(16, 4)
  roundOffAmount         Decimal         @default(0.0000) @map("round_off_amount") @db.Decimal(16, 4)
  totalInvoiceAmount     Decimal         @default(0.0000) @map("total_invoice_amount") @db.Decimal(16, 4)
  version                Int             @default(1)
  originalInvoiceId      String?         @map("original_invoice_id") @db.Uuid
  isEInvoiceGenerated    Boolean         @default(false) @map("is_einvoice_generated")
  irn                    String?         @db.VarChar(64)
  isStatutoryLocked      Boolean         @default(false) @map("is_statutory_locked")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company               Company               @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  gstRegistration       GSTRegistration       @relation(fields: [gstinId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)
  branch                Branch?               @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: SetNull)
  party                 Party                 @relation(fields: [partyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  taxPeriod             TaxPeriod             @relation(fields: [taxPeriodId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lineItems             InvoiceItem[]
  taxLedgerEntries      TaxLedgerEntry[]
  itcRecords            ItcRecord[]
  reconciliationMatches ReconciliationMatch[]
  eInvoices             EInvoiceRecord[]
  eWayBills             EWayBillRecord[]

  @@unique([id, tenantId])
  @@unique([tenantId, gstinId, invoiceNumber, category])
  @@index([tenantId, taxPeriodId])
  @@map("sales_invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  itemNumber     Int     @map("item_number")
  hsnSacCode     String  @map("hsn_sac_code") @db.VarChar(10)
  description    String  @db.Text
  quantity       Decimal @default(1.0000) @db.Decimal(16, 4)
  unitPrice      Decimal @map("unit_price") @db.Decimal(16, 4)
  discountAmount Decimal @default(0.0000) @map("discount_amount") @db.Decimal(16, 4)
  taxableValue   Decimal @map("taxable_value") @db.Decimal(16, 4)
  cgstRate       Decimal @default(0.00) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0.0000) @map("cgst_amount") @db.Decimal(16, 4)
  sgstRate       Decimal @default(0.00) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount     Decimal @default(0.0000) @map("sgst_amount") @db.Decimal(16, 4)
  igstRate       Decimal @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount     Decimal @default(0.0000) @map("igst_amount") @db.Decimal(16, 4)
  cessRate       Decimal @default(0.00) @map("cess_rate") @db.Decimal(5, 2)
  cessAmount     Decimal @default(0.0000) @map("cess_amount") @db.Decimal(16, 4)
  totalAmount    Decimal @map("total_amount") @db.Decimal(16, 4)

  salesInvoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ==========================================
// GSTR-2B & ITC Lifecycle Models
// ==========================================

model Gstr2bImportBatch {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  gstinId        String   @map("gstin_id") @db.Uuid
  taxPeriodId    String   @map("tax_period_id") @db.Uuid
  periodKey      String   @map("period_key") @db.VarChar(7)
  sourceFilename String   @map("source_filename") @db.VarChar(255)
  recordCount    Int      @default(0) @map("record_count")
  importStatus   String   @default("COMPLETED") @map("import_status") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gstRegistration GSTRegistration   @relation(fields: [gstinId, tenantId], references: [id, tenantId], onDelete: Cascade)
  taxPeriod       TaxPeriod         @relation(fields: [taxPeriodId, tenantId], references: [id, tenantId], onDelete: Cascade)
  records         Gstr2bRecord[]
  reconciliationRuns ReconciliationRun[]

  @@index([tenantId, gstinId, periodKey])
  @@map("gstr2b_import_batches")
}

model Gstr2bRecord {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  gstinId         String                 @map("gstin_id") @db.Uuid
  batchId         String                 @map("batch_id") @db.Uuid
  taxPeriodId     String                 @map("tax_period_id") @db.Uuid
  periodKey       String                 @map("period_key") @db.VarChar(7)
  supplierGstin   String                 @map("supplier_gstin") @db.VarChar(15)
  supplierName    String                 @map("supplier_name") @db.VarChar(255)
  invoiceNumber   String                 @map("invoice_number") @db.VarChar(100)
  invoiceDate     DateTime               @map("invoice_date") @db.Date
  invoiceType     String                 @default("B2B") @map("invoice_type") @db.VarChar(50)
  taxableValue    Decimal                @default(0.0000) @map("taxable_value") @db.Decimal(16, 4)
  cgstAmount      Decimal                @default(0.0000) @map("cgst_amount") @db.Decimal(16, 4)
  sgstAmount      Decimal                @default(0.0000) @map("sgst_amount") @db.Decimal(16, 4)
  igstAmount      Decimal                @default(0.0000) @map("igst_amount") @db.Decimal(16, 4)
  cessAmount      Decimal                @default(0.0000) @map("cess_amount") @db.Decimal(16, 4)
  totalTaxAmount  Decimal                @default(0.0000) @map("total_tax_amount") @db.Decimal(16, 4)
  totalInvoiceAmount Decimal             @default(0.0000) @map("total_invoice_amount") @db.Decimal(16, 4)
  itcAvailability Gstr2bItcAvailability  @default(ELIGIBLE) @map("itc_availability")
  rawPayload      Json?                  @db.JsonB
  createdAt       DateTime               @default(now()) @map("created_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gstRegistration       GSTRegistration       @relation(fields: [gstinId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batch                 Gstr2bImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  taxPeriod             TaxPeriod             @relation(fields: [taxPeriodId, tenantId], references: [id, tenantId], onDelete: Cascade)
