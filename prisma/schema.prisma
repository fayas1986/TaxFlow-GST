  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  action            String   @db.VarChar(100)
  entityType        String   @map("entity_type") @db.VarChar(100)
  entityId          String?  @map("entity_id") @db.VarChar(100)
  correlationId     String   @map("correlation_id") @db.VarChar(100)
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  beforeState       Json?    @map("before_state") @db.JsonB
  afterState        Json?    @map("after_state") @db.JsonB
  result            String   @default("SUCCESS") @db.VarChar(50)
  reason            String?  @db.Text
  payloadHash       String   @map("payload_hash") @db.VarChar(64)
  previousEventHash String   @map("previous_event_hash") @db.VarChar(64)
  currentEventHash  String   @map("current_event_hash") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("immutable_audit_logs")
}

model DocumentMetadata {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  companyId        String?      @map("company_id") @db.Uuid
  gstinId          String?      @map("gstin_id") @db.Uuid
  branchId         String?      @map("branch_id") @db.Uuid
  documentType     DocumentType @map("document_type")
  entityType       String       @map("entity_type") @db.VarChar(100)
  entityId         String       @map("entity_id") @db.VarChar(100)
  fileName         String       @map("file_name") @db.VarChar(255)
  mimeType         String       @map("mime_type") @db.VarChar(100)
  sizeBytes        Int          @map("size_bytes")
  sha256Hash       String       @map("sha256_hash") @db.VarChar(64)
  objectKey        String       @map("object_key") @db.VarChar(500)
  version          Int          @default(1)
  parentDocumentId String?      @map("parent_document_id") @db.Uuid
  createdById      String       @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("document_metadata")
}

model NotificationRecord {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  userId         String?             @map("user_id") @db.Uuid
  channel        NotificationChannel
  eventType      String              @map("event_type") @db.VarChar(100)
  recipient      String              @db.VarChar(255)
  payload        Json                @db.JsonB
  status         NotificationStatus  @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error") @db.Text
  idempotencyKey String              @map("idempotency_key") @db.VarChar(255)
  correlationId  String              @map("correlation_id") @db.VarChar(100)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("notification_records")
}

// ==========================================
// Stage 9: ERP & External Integration Platform
// ==========================================

model ErpIntegration {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  provider             IntegrationProvider
  name                 String              @db.VarChar(255)
  encryptedApiEndpoint String?             @map("encrypted_api_endpoint") @db.Text
  encryptedCredentials String              @map("encrypted_credentials") @db.Text
  webhookSecret        String?             @map("webhook_secret") @db.VarChar(255)
  isActive             Boolean             @default(true) @map("is_active")
  lastSyncAt           DateTime?           @map("last_sync_at")
  lastSyncStatus       SyncRunStatus?      @map("last_sync_status")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mappingConfigs       IntegrationMappingConfig[]
  syncRuns             SyncRunLog[]
  importedTransactions ImportedTransactionRecord[]
  errors               IntegrationErrorLog[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("erp_integrations")
}

model IntegrationMappingConfig {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  integrationId   String   @map("integration_id") @db.Uuid
  name            String   @db.VarChar(255)
  version         Int      @default(1)
  fieldMappings   Json     @map("field_mappings") @db.JsonB
  transformations Json?    @db.JsonB
  isDefault       Boolean  @default(true) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration ErpIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, name, version])
  @@index([tenantId, integrationId])
  @@map("integration_mapping_configs")
}

model SyncRunLog {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  integrationId   String        @map("integration_id") @db.Uuid
  status          SyncRunStatus @default(PENDING)
  sourceSystem    String        @map("source_system") @db.VarChar(100)
  recordsReceived Int           @default(0) @map("records_received")
  recordsCreated  Int           @default(0) @map("records_created")
  recordsUpdated  Int           @default(0) @map("records_updated")
  recordsSkipped  Int           @default(0) @map("records_skipped")
  recordsFailed   Int           @default(0) @map("records_failed")
  startedAt       DateTime      @default(now()) @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  durationMs      Int?          @map("duration_ms")
  correlationId   String        @map("correlation_id") @db.VarChar(100)
  summary         Json?         @db.JsonB

  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration          ErpIntegration             @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  importedTransactions ImportedTransactionRecord[]
  errors               IntegrationErrorLog[]

  @@index([tenantId, startedAt])
  @@index([correlationId])
  @@map("sync_run_logs")
}

model ImportedTransactionRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  integrationId        String   @map("integration_id") @db.Uuid
  syncRunId            String?  @map("sync_run_id") @db.Uuid
  sourceSystem         String   @map("source_system") @db.VarChar(100)
  externalDocumentId   String   @map("external_document_id") @db.VarChar(100)
  externalCompanyRef   String?  @map("external_company_ref") @db.VarChar(100)
  documentType         String   @map("document_type") @db.VarChar(50)
  documentNumber       String   @map("document_number") @db.VarChar(100)
  documentDate         DateTime @map("document_date") @db.Date
  sourcePayloadHash    String   @map("source_payload_hash") @db.VarChar(64)
  canonicalPayload     Json     @map("canonical_payload") @db.JsonB
  taxflowInvoiceId     String?  @map("taxflow_invoice_id") @db.Uuid
  erpCalculatedTax     Decimal  @default(0.0000) @map("erp_calculated_tax") @db.Decimal(16, 4)
  taxflowCalculatedTax Decimal  @default(0.0000) @map("taxflow_calculated_tax") @db.Decimal(16, 4)
  taxVariance          Decimal  @default(0.0000) @map("tax_variance") @db.Decimal(16, 4)
  isTaxMatched         Boolean  @default(true) @map("is_tax_matched")
  status               String   @default("PROCESSED") @db.VarChar(50)
  importTimestamp      DateTime @default(now()) @map("import_timestamp")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration ErpIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  syncRun     SyncRunLog?    @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([tenantId, integrationId, externalDocumentId, documentType])
  @@index([tenantId, importTimestamp])
  @@map("imported_transaction_records")
}

model IntegrationErrorLog {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  integrationId      String                   @map("integration_id") @db.Uuid
  syncRunId          String?                  @map("sync_run_id") @db.Uuid
  externalDocumentId String?                  @map("external_document_id") @db.VarChar(100)
  category           IntegrationErrorCategory
  errorCode          String                   @map("error_code") @db.VarChar(100)
  errorMessage       String                   @map("error_message") @db.Text
  rawPayload         Json?                    @map("raw_payload") @db.JsonB
  createdAt          DateTime                 @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration ErpIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  syncRun     SyncRunLog?    @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("integration_error_logs")
}

// ==========================================
// Stage 10: Billing, Subscription, Entitlements & Usage
// ==========================================

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  planCode          String             @default("ENTERPRISE") @map("plan_code") @db.VarChar(50)
  status            SubscriptionStatus @default(TRIAL)
  billingCycle      BillingCycle       @default(MONTHLY) @map("billing_cycle")
  startDate         DateTime           @default(now()) @map("start_date")
  renewalDate       DateTime           @map("renewal_date")
  trialEndsAt       DateTime?          @map("trial_ends_at")
  customLimits      Json?              @map("custom_limits") @db.JsonB
  customFeatures    Json?              @map("custom_features") @db.JsonB
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingEvents BillingEvent[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("subscriptions")
}

model UsageCounterRecord {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  periodKey    String   @map("period_key") @db.VarChar(10)
  metric       String   @db.VarChar(50)
  currentValue BigInt   @default(0) @map("current_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodKey, metric])
  @@index([tenantId, periodKey])
  @@map("usage_counter_records")
}

model UsageEventLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  metric         String   @db.VarChar(50)
  delta          Int      @default(1)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  entityType     String?  @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.VarChar(100)
  correlationId  String   @map("correlation_id") @db.VarChar(100)
  timestamp      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, timestamp])
  @@map("usage_event_logs")
}

model BillingEvent {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  eventType         String        @map("event_type") @db.VarChar(100)
  amountInr         Decimal       @default(0.0000) @map("amount_inr") @db.Decimal(16, 4)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  providerReference String?       @map("provider_reference") @db.VarChar(255)
  idempotencyKey    String        @map("idempotency_key") @db.VarChar(255)
  payload           Json?         @db.JsonB
  createdAt         DateTime      @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("billing_events")
}

model BackgroundJobRecord {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  userId         String?             @map("user_id") @db.Uuid
  domain         JobDomain
  jobType        String              @map("job_type") @db.VarChar(100)
  idempotencyKey String              @map("idempotency_key") @db.VarChar(255)
  status         BackgroundJobStatus @default(QUEUED)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3) @map("max_attempts")
  payload        Json                @db.JsonB
  result         Json?               @db.JsonB
  errorMessage   String?             @map("error_message") @db.Text
  correlationId  String              @map("correlation_id") @db.VarChar(100)
  lockedAt       DateTime?           @map("locked_at")
  lockedBy       String?             @map("locked_by") @db.VarChar(100)
  stalledAt      DateTime?           @map("stalled_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  completedAt    DateTime?           @map("completed_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   JobExecutionLog[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([domain, status])
  @@map("background_job_records")
}

model JobExecutionLog {
  id              String              @id @default(uuid()) @db.Uuid
  jobId           String              @map("job_id") @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  attempt         Int
  status          BackgroundJobStatus
  executionTimeMs Int                 @default(0) @map("execution_time_ms")
  logMessage      String              @map("log_message") @db.Text
  timestamp       DateTime            @default(now())

  job BackgroundJobRecord @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([tenantId, timestamp])
  @@map("job_execution_logs")
}






